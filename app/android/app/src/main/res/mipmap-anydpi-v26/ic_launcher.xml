<?xml version="1.0" encoding="utf-8"?>
<!--
  Адаптивный значок. Без него Android 8+ сам вписывает наш PNG в системную
  маску и подкладывает белый фон — результат никто не контролирует.
  monochrome нужен темам Android 13: система перекрашивает слой под обои.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
