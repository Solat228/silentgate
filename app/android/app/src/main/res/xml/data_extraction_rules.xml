<?xml version="1.0" encoding="utf-8"?>
<!--
  Резервная копия Google и перенос на новое устройство (Android 12+).

  ⚠️ В КОПИЮ ИДЁТ ТОЛЬКО СНИМОК files/SilentGate/backup/. Всё остальное — журналы,
  кэш значков, гео-базы, секреты сессии (пароль Clash API, пароль проб),
  восстановленный конфиг постоянной VPN — остаётся вне копии по построению:
  при наличии <include> система берёт ровно перечисленное.

  Снимок собирает приложение (`SettingsBackup.writeSnapshot`): настройки без
  секретов устройства и — если человек не выключил «Сохранять подписки в
  резервной копии Google» — подписки. Адрес подписки — токен доступа, поэтому
  облачная копия разрешена только там, где она шифруется на устройстве
  (disableIfNoEncryptionCapabilities): без блокировки экрана Google хранил бы
  её с ключом на своей стороне.

  Решение владельца 19.10.2026 (P11). До этого бэкап был выключен целиком.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="SilentGate/backup/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="SilentGate/backup/" />
    </device-transfer>
</data-extraction-rules>
