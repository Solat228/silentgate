<?xml version="1.0" encoding="utf-8"?>
<!--
  Что FileProvider разрешает отдавать наружу.

  ⚠️ Только каталог отчётов поддержки, и ничего больше. Рядом в files/SilentGate
  лежат настройки, состояние и подписки — а в них токен подписки. Открывать
  внешним программам весь каталог означало бы отдать его любому, кому
  пользователь однажды «поделился» отчётом.

  Второй корень — каталог скачанных обновлений в cache (`cacheDir/updates/`):
  системному установщику нужен content://-доступ к APK. Только этот
  подкаталог, не весь cache: рядом в cache могут оказаться временные файлы
  закачек и кэши картинок, и им наружу незачем. Токенов там нет по построению
  (в updates/ пишет только закачка обновления), а `files/SilentGate`
  по-прежнему закрыт.

  Третий корень — файл экспорта настроек (`files/SilentGate/export/`, P11).
  Человек сам нажал «Экспорт» и сам выбирает, кому отдать файл; в каталоге
  лежит только последний экспорт — прежний удаляется при новом.
-->
<paths>
    <files-path name="support" path="SilentGate/support/"/>
    <cache-path name="updates" path="updates/"/>
    <files-path name="export" path="SilentGate/export/"/>
</paths>
