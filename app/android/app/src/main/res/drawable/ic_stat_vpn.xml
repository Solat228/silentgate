<!--
  Значок в статус-баре. ОБЯЗАТЕЛЬНО монохромный: Android рисует small icon по
  альфа-маске, и цветной рисунок превратился бы в белый квадрат. Поэтому здесь
  силуэт, а не знак целиком.

  ⚠️ ПОЧЕМУ ЗНАЧОК ВЫГЛЯДЕЛ «ОБРЕЗАННЫМ И СПИЛЕННЫМ». Дело было не в форме, а в
  размере. Пути занимали холст ЦЕЛИКОМ: по вертикали от y=0 до y≈24 при
  viewport 24, то есть впритык к обеим граням. Система поджимает значки
  статус-бара под свою высоту и рисует их в безопасной области — всё, что
  доходит до края, срезается. Правка формы тут не помогала бы никогда: сколько
  ни доводи уголок, обрезался он снаружи.

  Теперь силуэт вписан группой: масштаб 0,75 и сдвиг дают рисунку поле около
  3dp с каждой стороны (x 4,7…19,2, y 3…21 при холсте 24×24). Порядок
  преобразований у VectorDrawable при pivot 0,0 — сначала масштаб, потом
  сдвиг, поэтому координаты считаются как x·0,75 + 3,02.

  ⚠️ Менять размеры и сдвиг группы не надо — правится ТОЛЬКО pathData внутри.
  Если добавляете фигуры, держите их в тех же исходных координатах 0…24:
  группа сама уведёт их в безопасную область.

  ⚠️ И отдельно про сам знак: форма ниже обведена с `assets/tray_icon.ico`, а
  он, как выяснилось, до сих пор содержит стандартный логотип Flutter из
  шаблона проекта. Своего знака у приложения нет ни здесь, ни на рабочем столе.
  Когда появится настоящий — заменить pathData тут и картинки в mipmap-*.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <group
        android:pivotX="0"
        android:pivotY="0"
        android:scaleX="0.75"
        android:scaleY="0.75"
        android:translateX="3.02"
        android:translateY="3">
        <!-- Верхняя косая полоса. -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M14.314,0L2.3,12l3.7,3.7L21.6,0.1h-7.286z"/>
        <!-- Нижний уголок. -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M14.34,11.933L7.4,18.876l3.669,3.706 3.671,-3.694L21.6,11.9h-7.26z"/>
        <!-- Складка — третья часть знака. -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M11.069,22.582l3.671,-3.694 3.665,3.699 -3.665,1.413z"/>
    </group>
</vector>
